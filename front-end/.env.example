# Local development — the ONE env file.
#
# Both tools read this: the Prisma CLI (migrate / seed / studio) loads `.env` by
# convention, and Next.js loads it too. Keeping DATABASE_URL in a single place
# is why `.env.local` no longer exists — it was invisible to Prisma, so
# `npm run prisma:seed` failed with "Environment variable not found".
#
# In production the app reads NOTHING from here: every value is a Cloudflare
# binding or secret (see wrangler.jsonc).

# Postgres. Locally this is the docker-compose database; in production point it
# at the Neon connection string when running migrations.
DATABASE_URL="postgresql://pcstore39:pcstore39@localhost:5435/pcstore39"

# Public origin of the storefront — used for robots.txt / sitemap.xml URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
